<UserControl x:Class="MechToolbox.Desktop.Views.BoltQueryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MechToolbox.Desktop.Views">
  <TabControl BorderThickness="0" Background="Transparent" Padding="0,16,0,0">
    <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Padding" Value="18,10"/><Setter Property="FontSize" Value="14"/></Style></TabControl.Resources>
    <TabItem Header="尺寸查询">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,4,4,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel>
            <Border Style="{StaticResource Card}" Padding="18">
              <StackPanel>
                <TextBlock Text="01  选择螺栓" Style="{StaticResource Caption}" Margin="0,0,0,18"/>
                <TextBlock Text="公称直径" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ComboBox ItemsSource="{Binding Sizes}" SelectedItem="{Binding SelectedSize}" DisplayMemberPath="Spec" IsTextSearchEnabled="True" TextSearch.TextPath="Spec" AutomationProperties.Name="螺栓公称直径"/>
                <TextBlock Text="常用规格" Style="{StaticResource Caption}" Margin="0,22,0,10"/>
                <UniformGrid Columns="3">
                  <Button Content="M4" Tag="4" Click="QuickSelect" Padding="0,10" Margin="0,0,5,6"/><Button Content="M6" Tag="6" Click="QuickSelect" Padding="0,10" Margin="0,0,5,6"/><Button Content="M8" Tag="8" Click="QuickSelect" Padding="0,10" Margin="0,0,0,6"/>
                  <Button Content="M10" Tag="10" Click="QuickSelect" Padding="0,10" Margin="0,0,5,0"/><Button Content="M12" Tag="12" Click="QuickSelect" Padding="0,10" Margin="0,0,5,0"/><Button Content="M16" Tag="16" Click="QuickSelect" Padding="0,10"/>
                </UniformGrid>
                <Border Height="1" Background="{StaticResource Line}" Margin="0,22,0,18"/>
                <TextBlock Text="螺纹系列" Style="{StaticResource Caption}"/><TextBlock Text="公制普通粗牙" Margin="0,6,0,16"/>
              </StackPanel>
            </Border>
            <Border Background="#E6EFEE" CornerRadius="8" Padding="16" Margin="0,16,0,0"><StackPanel><TextBlock Text="使用提示" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,0,9"/><TextBlock Style="{StaticResource Caption}" Text="仅查询公制粗牙。选中标号后，可查看攻丝底孔、内六角圆柱头尺寸和三档装配通孔。" LineHeight="21"/></StackPanel></Border>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="{Binding SelectedSize.Spec}" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="公制粗牙 · 右旋 · 单位 mm" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel><Button Content="复制查询结果" Click="CopyResult" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"/></Grid>
            <TextBlock Text="02  螺纹孔" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
            <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="成品内螺纹 · 建议标注" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SelectedSize.ThreadCallout}" FontFamily="Segoe UI" FontSize="24" FontWeight="SemiBold" Margin="0,14,0,12"/><TextBlock Text="6H：一般用途 · 正常旋合长度" Style="{StaticResource Caption}"/><TextBlock Text="{Binding ThreadLimits.PitchDeviation}" Style="{StaticResource Caption}" Margin="0,10,0,4"/><TextBlock Text="{Binding ThreadLimits.PitchRange}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding ThreadLimits.MinorDeviation}" Style="{StaticResource Caption}" Margin="0,10,0,4"/><TextBlock Text="{Binding ThreadLimits.MinorRange}" Style="{StaticResource Caption}"/></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="切削攻丝 · 推荐底孔" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SelectedSize.TapText}" FontFamily="Segoe UI" FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,6,0,8"/><TextBlock Text="按推荐钻径选用，不适用于挤压丝锥" Style="{StaticResource Caption}"/></StackPanel></Border>
            </Grid>
            <TextBlock Text="03  内六角圆柱头尺寸 · GB/T 70.1-2008" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,22">
              <StackPanel>
                <Grid x:Name="HeadDimensions" AutomationProperties.Name="内六角圆柱头尺寸">
                  <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding Head}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,10,10"><TextBlock Text="光滑头最大外径 dₖ" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Head.SmoothText}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,10,10"><TextBlock Text="最大头高 k" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Head.HeightText}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                  <StackPanel Grid.Column="2" Margin="0,0,0,10"><TextBlock Text="内六角公称对边 s" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Head.SocketText}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                </Grid>
                <TextBlock Text="{Binding HeadNotice}" Style="{StaticResource Caption}" LineHeight="20"/>
              </StackPanel>
            </Border>
            <TextBlock Text="04  通孔 · 选择装配系列" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
            <ListBox ItemsSource="{Binding Clearances}" SelectedItem="{Binding SelectedClearance}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="通孔装配系列">
              <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="2" CornerRadius="9" Padding="14"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Card" Property="Background" Value="#EAF4F1"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#83B6AF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding SizeText}" FontFamily="Segoe UI" FontSize="32" FontWeight="SemiBold" Margin="0,10,0,10"/><TextBlock Text="{Binding DeviationText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBlock Text="{Binding LimitsText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/><TextBlock Text="{Binding GapText}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <local:ClearanceDiagram Diameter="{Binding SelectedSize.Diameter}" HoleDiameter="{Binding SelectedClearance.Diameter}" Height="148" Margin="0,0,18,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding SelectionTitle}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedClearance.UseCase}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,10,0,8" LineHeight="20"/><TextBlock Text="{Binding ToleranceText}" Style="{StaticResource Caption}"/><TextBlock Text="俯视示意：浅色为间隙，深色为螺栓公称截面。" Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel>
              </Grid>
            </Border>
            <TextBlock Text="底孔按 GB/T 20330-2006 表 1；适用于正常旋合长度的切削攻丝。通孔按 GB/T 5277-1985，无特殊要求时采用 H12 / H13 / H14，数值偏差按 GB/T 1800.2-2020；间隙系列不代表定位精度。" Style="{StaticResource Caption}" LineHeight="20" Margin="0,16,0,0"/>
            <TextBlock Text="{Binding SourceText}" Style="{StaticResource Caption}" FontSize="11" Margin="0,8,0,0"/>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="孔径反查">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,4,0,16">
          <TextBlock Text="输入一个孔径，查看所有可能的粗牙标号" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/>
          <StackPanel Width="230" HorizontalAlignment="Left"><TextBlock Text="孔径（mm）" Style="{StaticResource Caption}" Margin="0,0,0,7"/><TextBox Text="{Binding Reverse.DiameterText, UpdateSourceTrigger=PropertyChanged}" FontSize="24" MaxLength="12" AutomationProperties.Name="反查孔径"/></StackPanel>
          <TextBlock Text="显示输入孔径 ±3 mm 内的三档装配通孔和切削攻丝底孔，包含边界值。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>
          <TextBlock Text="{Binding Reverse.Message}" TextWrapping="Wrap" Foreground="{StaticResource Accent}" FontSize="14" Margin="0,16,0,0"/>
        </StackPanel>
        <DataGrid Grid.Row="1" x:Name="ReverseTable" ItemsSource="{Binding Reverse.Matches}" MouseDoubleClick="ReverseDoubleClick" AutomationProperties.Name="孔径反查候选结果">
          <DataGrid.Columns><DataGridTextColumn Header="粗牙标号" Binding="{Binding Spec}" Width="130"/><DataGridTextColumn Header="可能的用途" Binding="{Binding HoleName}" Width="*"/><DataGridTextColumn Header="推荐孔径 / mm" Binding="{Binding HoleText}" Width="150"/><DataGridTextColumn Header="差值 / mm" Binding="{Binding DifferenceText}" Width="130"/></DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="2" Background="#E6EFEE" CornerRadius="8" Padding="16" Margin="0,14,0,0"><TextBlock Text="差值 = 推荐孔径 − 输入孔径，0 表示相同。例如输入 12 mm，显示 9～15 mm 的全部候选。接近的孔径供比较选用，不代表现有孔适用；成品内螺纹的实测小径不能直接作为攻丝前底孔反查。" Style="{StaticResource Caption}" LineHeight="21"/></Border>
      </Grid>
    </TabItem>
  </TabControl>
</UserControl>
