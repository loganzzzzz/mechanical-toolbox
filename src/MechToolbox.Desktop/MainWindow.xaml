<Window x:Class="MechToolbox.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="机设工具箱 · Mechanical Toolbox" Icon="Assets/toolbox.ico" Width="1200" Height="900" MinWidth="1020" MinHeight="720" FontFamily="Microsoft YaHei UI, Segoe UI" Background="#F3F6F7" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#152A3B">
      <DockPanel Margin="18,28,18,20" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="10,0,0,38">
          <Image Source="Assets/toolbox.png" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,12"/><TextBlock Text="机设工具箱" FontSize="22" Foreground="White" FontWeight="Bold"/>
          <TextBlock Text="MECHANICAL TOOLBOX" Foreground="#91A6B5" FontSize="9" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="10,20,0,0">
          <TextBlock Text="●  离线可用" Foreground="#91C8BD" FontSize="12"/>
          <TextBlock Text="v0.3.1  /  公制 · mm" Foreground="#91A6B5" FontSize="11" Margin="0,10,0,0"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="标准查询" Foreground="#91A6B5" FontSize="11" Margin="10,0,0,12"/>
          <ListBox x:Name="ModuleList" Background="Transparent" BorderThickness="0" SelectionChanged="ModuleChanged" Foreground="White" FontSize="14" Margin="0,0,0,24">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,14"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Item" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#2A4B5B"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="#244354"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="White"/></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <Button Content="标准数据与依据" Click="ShowSources" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#C6D4DE" BorderThickness="0" Margin="0,0,0,6"/>
          <Button Content="扩展与版本" Click="ShowExtensions" Background="Transparent" Foreground="#C6D4DE" BorderThickness="0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="30,0">
        <Grid><StackPanel VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="螺纹孔与通孔" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="尺寸速查，让设计更专注。" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EAF4F1" Padding="12,7" CornerRadius="12"><TextBlock x:Name="StandardBadge" Text="公制粗牙  /  ISO" Foreground="{StaticResource Accent}" FontSize="11"/></Border></Grid>
      </Border>
      <ContentControl x:Name="PageHost" Grid.Row="1" Margin="26,22,26,16"/>
      <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="26,0"><TextBlock x:Name="Status" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="就绪 · 所有尺寸单位为 mm"/></Border>
    </Grid>
  </Grid>
</Window>
